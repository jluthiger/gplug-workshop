{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "infomaniak": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Infomaniak AI (Schweiz)",
      "options": {
        "baseURL": "https://api.infomaniak.com/2/ai/{env:INFOMANIAK_PRODUCT_ID}/openai/v1",
        "apiKey": "{env:INFOMANIAK_API_KEY}"
      },
      "models": {
        "Qwen/Qwen3.5-122B-A10B-FP8": {
          "name": "Qwen3.5 122B-A10B",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 200000, "output": 65536 }
        },
        "moonshotai/Kimi-K2.6": {
          "name": "Kimi K2.6",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 256000, "output": 32768 }
        },
        "Qwen/Qwen3.5-397B-A17B-FP8": {
          "name": "Qwen3.5 397B-A17B",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 200000, "output": 65536 }
        },
        "mistralai/Mistral-Small-4-119B-2603": {
          "name": "Mistral Small 4",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 256000, "output": 32768 }
        },
        "mistralai/Ministral-3-14B-Instruct-2512": {
          "name": "Ministral 3 14B",
          "tool_call": true,
          "limit": { "context": 100000, "output": 25600 }
        }
      }
    }
  },
  "model": "infomaniak/Qwen/Qwen3.5-122B-A10B-FP8",
  "small_model": "infomaniak/mistralai/Ministral-3-14B-Instruct-2512",
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "external_directory": "deny",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm *": "deny",
      "sudo *": "deny"
    }
  }
}
